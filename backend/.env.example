# Copy to .env (never commit .env). Only META_API_KEY and FRONTEND_ORIGIN are required.
META_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000

# Optional: if set, the app asks for this code before a meeting starts (protects credits)
ACCESS_CODE=

# MOCK_META=1 -> fake transcript/cards/images, 0 credits (for frontend work)
MOCK_META=0
# MOCK_DELAY_S=4 -> mock calls take as long as real ones (to see the "thinking" UI states); 0 = instant
MOCK_DELAY_S=0
# DEBUG_VOICE=1 -> log raw Meta voice messages (first real run)
DEBUG_VOICE=0
# DEBUG_DUMP=1 -> local testing only: saves transcript + every Spark call to backend/debug/<session>.json
DEBUG_DUMP=0

# Tuning (defaults shown)
SPARK_INTERVAL_S=40
SPARK_REASONING=low
IMAGE_REASONING=low
MAX_IMAGES=80
# Flow Map boxes per meeting (a 32-min meeting reached 40)
MAX_FLOW_STEPS=80
AUTO_GAP_CHECK_S=240
# second opinions (separate Spark calls): conflicts, gap answers / already-answered gaps, settled conflicts, open-gap re-checks
VERIFY_CONFLICTS=1
VERIFY_FLOW=1
RECHECK_GAPS=1
MAX_GAP_RECHECKS=5
MAX_SPARK_CALLS=150
MAX_ACTIVE_SESSIONS=3
SESSIONS_PER_IP_PER_HOUR=6
MAX_SESSION_MINUTES=180
