# Backend URL (baked in at BUILD time — rebuild after changing it)
# local:      http://localhost:8000
# production: .env.production (the site URL; frontend and backend share one origin)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Landing page (all optional, baked in at build time)
# YouTube id of the 3-minute demo video; empty = the landing page links the demo replay instead
NEXT_PUBLIC_DEMO_VIDEO_ID=
# replay id of the public demo meeting (also put it in the backend's PINNED_REPLAYS so it is kept past 30 days)
NEXT_PUBLIC_DEMO_REPLAY_ID=
# contact address shown in the footer and the privacy policy
NEXT_PUBLIC_CONTACT_EMAIL=
